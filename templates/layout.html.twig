{% extends 'base.html.twig' %}

{% block stylesheets %}
<style>
    body { font-family: Arial, sans-serif; margin: 0; background: #f6f4f9; color: #2b2b2b; }
    nav { background: #5b2a86; padding: 14px 32px; }
    nav a { color: #fff; text-decoration: none; font-weight: bold; }
    main { max-width: 1100px; margin: 24px auto; padding: 0 16px; }
    h1 { color: #5b2a86; }
    table { width: 100%; border-collapse: collapse; background: #fff; }
    th, td { padding: 10px 12px; border-bottom: 1px solid #e3dcee; text-align: left; }
    th { background: #ece4f5; }
    .carte { background: #fff; border-radius: 8px; padding: 16px 20px; margin-bottom: 20px; }
    .retour { display: inline-block; margin-bottom: 16px; color: #5b2a86; }
</style>
{% endblock %}

{% block body %}
<nav><a href="{{ path('app_groupement_index') }}">AvecLesFemmes</a></nav>
<main>
    {% block contenu %}{% endblock %}
</main>
{% endblock %}